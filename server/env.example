# Server
PORT=3000
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://yourusername.github.io
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=3600000

# Email notifications
# Gmail users should create an App Password and keep EMAIL_SERVICE=gmail.
EMAIL_SERVICE=gmail
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-character-app-password
OWNER_EMAIL=shreerajco@yahoo.com

# Optional custom SMTP provider. Leave blank when using EMAIL_SERVICE.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional Firestore storage. Paste the full service account JSON as one line.
# If omitted, the API stores submissions in server/data/contact-submissions.jsonl.
FIREBASE_SERVICE_ACCOUNT=

# Local file storage fallback
DATA_DIR=data
DISABLE_FILE_STORAGE=false
